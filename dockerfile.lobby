# Fake DirectPlay8 lobby: a small UDP proxy that stands in front of the
# real AoM game pod's discovery port (2299), rewriting the embedded host
# address in discovery/ping replies to point at itself instead. See
# lobby/main.go and docs/directplay8-protocol.md.

FROM golang:1.22-alpine AS builder
WORKDIR /src
COPY lobby/go.mod ./
COPY lobby/main.go ./
RUN CGO_ENABLED=0 go build -o /aom-lobby .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=builder /aom-lobby /usr/local/bin/aom-lobby
# Non-root - all three listen ports (2299/2300/8080) are >1024, so no
# CAP_NET_BIND_SERVICE needed. Also lets k8s/aks/lobby-deployment.yaml's
# securityContext (runAsNonRoot: true) actually hold - alpine's default
# user is root, which would otherwise fail that check at pod start.
RUN adduser -D -H aomlobby
USER aomlobby
EXPOSE 2299/udp
ENTRYPOINT ["/usr/local/bin/aom-lobby"]
